# WeVibe bench local-proxy configuration (.env is gitignored; keep it local)
# Resolution order for LOCAL_LLM_PROXY_API_KEY:
#   1) this .env file (LOCAL_LLM_PROXY_API_KEY)
#   2) ~/.config/opencode/opencode.json -> provider.local-llm-proxy.options.apiKey
#
# LOCAL_LLM_PROXY_API_KEY is the consumer token for the Local LLM Proxy (:4545).
LOCAL_LLM_PROXY_API_KEY=

# Optional override for spend meter DB DSN (default shown below):
# WEVIBE_BENCH_SPEND_DB_DSN=postgresql://spend_proxy:spend_proxy_dev@127.0.0.1:5440/spend_proxy
WEVIBE_BENCH_SPEND_DB_DSN=

# Optional override for local-proxy base URL (default shown below):
# WEVIBE_BENCH_SPEND_PROXY_BASE_URL=http://127.0.0.1:4545/v1
WEVIBE_BENCH_SPEND_PROXY_BASE_URL=
