# WeVibe bench spend-proxy configuration (.env is gitignored; keep it local)
# Resolution order for ORCAROUTER_API_KEY:
#   1) this .env file (ORCAROUTER_API_KEY)
#   2) ~/.config/opencode/opencode.json -> provider.orcarouter.options.apiKey
#
# ORCAROUTER_API_KEY is the spend-proxy consumer token for :4480 (not the
# upstream OrcaRouter key). Create/list bench consumers with:
#   uv run python scripts/spend_proxy_admin.py create-consumer --consumer-id bench
ORCAROUTER_API_KEY=

# Optional override for spend meter DB DSN (default shown below):
# WEVIBE_BENCH_SPEND_DB_DSN=postgresql://spend_proxy:spend_proxy_dev@127.0.0.1:5440/spend_proxy
WEVIBE_BENCH_SPEND_DB_DSN=

# Optional override for spend-proxy base URL (default shown below):
# WEVIBE_BENCH_SPEND_PROXY_BASE_URL=http://127.0.0.1:4480/v1
WEVIBE_BENCH_SPEND_PROXY_BASE_URL=
