{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wevibe.dev/schemas/spool-v1.schema.json",
  "title": "WeVibe SPOOL-V1",
  "description": "Authoritative spec: wevibe-meta/workspace/docs/SPOOL-V1.md. Conformance tripwire: tests/test_spool_v1_conformance.py (this repo), against the plugin-produced fixture tests/fixtures/spool-v1.plugin-produced.jsonl (regen: npx tsx plugins/gen-spool-v1-fixture.ts in wevibe-opencode-plugin).",
  "type": "object",
  "required": [
    "v",
    "seq",
    "ts",
    "session_id",
    "trace_id",
    "event",
    "payload"
  ],
  "properties": {
    "v": {
      "const": "spool-v1"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event": {
      "type": "string",
      "enum": [
        "session.created",
        "session.idle",
        "session.error",
        "tool.execute.before",
        "tool.execute.after",
        "file.edited",
        "file.watcher.updated",
        "lsp.client.diagnostics",
        "command.executed",
        "gstv.attach.attempt",
        "gstv.boundary.run"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "session.created"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "directory"
            ],
            "properties": {
              "directory": {
                "type": "string"
              },
              "worktree": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "session.idle"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "session.error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "message_excerpt": {
                "type": "string",
                "maxLength": 2060,
                "description": "producer slices at 2048 then appends the 12-char truncation marker → wire max 2060"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "tool.execute.before"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "call_id",
              "tool"
            ],
            "properties": {
              "call_id": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "args_excerpt": {
                "type": "string",
                "maxLength": 2060,
                "description": "producer slices at 2048 then appends the 12-char truncation marker → wire max 2060"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "tool.execute.after"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "call_id",
              "tool"
            ],
            "properties": {
              "call_id": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "number"
              },
              "output_excerpt": {
                "type": "string",
                "maxLength": 2060,
                "description": "producer slices at 2048 then appends the 12-char truncation marker → wire max 2060"
              },
              "error_excerpt": {
                "type": "string",
                "maxLength": 2060,
                "description": "producer slices at 2048 then appends the 12-char truncation marker → wire max 2060"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "file.edited"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "file.watcher.updated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "lsp.client.diagnostics"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "path",
              "serverID",
              "diagnostics"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "serverID": {
                "type": "string"
              },
              "diagnostics": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "command.executed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "args_excerpt": {
                "type": "string",
                "maxLength": 2060,
                "description": "producer slices at 2048 then appends the 12-char truncation marker → wire max 2060"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "gstv.attach.attempt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "goal_id"
            ],
            "properties": {
              "goal_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "gstv.boundary.run"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "goal_id",
              "command",
              "exit_code",
              "duration_ms"
            ],
            "properties": {
              "goal_id": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
