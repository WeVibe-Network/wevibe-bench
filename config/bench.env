# =====================================================================
# wevibe-bench durable dev env  —  load with:  source config/bench.env
# (the Python driver entrypoints also auto-load this via wevibe_bench.benv)
#
# THROWAWAY LOCAL DEV SEEDS ONLY — NOT secrets, safe to commit for the
# local benchmark. Leader = all-ones, Contributor = repeating-d4,
# Wallet = a public local dev address. Any open-source extraction of this
# harness MUST NOT ship these (or any) real seeds.
# =====================================================================

# --- Canonical bench identity (verbatim from backstop runs/smoke/env.sh) ---
export WEVIBE_BENCH_LEADER_SEED_HEX=1111111111111111111111111111111111111111111111111111111111111111
export WEVIBE_BENCH_CONTRIB_SEED_HEX=d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4
export WEVIBE_BENCH_LEADER_WALLET=wevibe1ctsk4daak8syk8008z4ut4jls9yxdg8m7u52ka

# --- Aliases the clone / leader-signer read directly for STANDALONE starts ---
# The bench lifecycle overrides WEVIBE_IDENTITY_SEED_HEX per-spawned-clone
# (leader vs contributor), so these globals only matter for a manual
# `node dist/server.js` / leader-signer invocation — they make it hands-off.
export WEVIBE_IDENTITY_SEED_HEX="$WEVIBE_BENCH_LEADER_SEED_HEX"
export WEVIBE_LEADER_WALLET="$WEVIBE_BENCH_LEADER_WALLET"

# --- New clone home (canonical wevibe-mcp lacks bench /v1/submit endpoints) ---
# WEVIBE_BENCH_WEVIBE_ROOT is auto-seeded by wevibe_bench.benv to the workspace root;
# override via env/export if your repos live in a non-standard layout.
export WEVIBE_BENCH_MCP_ROOT=${WEVIBE_BENCH_WEVIBE_ROOT}/wevibe-bench/scaffold/wevibe-mcp-clone

# --- Corpus + infra ---
# Corpus dataset is generated locally (datasets/ is git-ignored); this is the expected default path.
export WEVIBE_BENCH_CORPUS_FILE=${WEVIBE_BENCH_WEVIBE_ROOT}/wevibe-bench/recall/corpus/go-concurrency-v1.json
# Recall-readiness gold fixture consumed by the post-seed slug→CID resolver.
export WEVIBE_BENCH_GOLD_FILE=${WEVIBE_BENCH_WEVIBE_ROOT}/wevibe-bench/recall/gold/go-concurrency-v1.gold.jsonl
# QDRANT_API_KEY defaults to a local-dev value in code; override via env/export for a real Qdrant.
export WEVIBE_BENCH_SKIP_BUILD=1
